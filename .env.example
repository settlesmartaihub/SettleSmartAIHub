# SettleSmart AI Backend Environment Configuration

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL Database Connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=settlesmart_user
DATABASE_PASSWORD=2222
DATABASE_NAME=settlesmart_db
DATABASE_SSL=false

# Database Pool & Performance Settings
DATABASE_MAX_CONNECTIONS=100
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT=60000
DATABASE_IDLE_TIMEOUT=10000
DATABASE_EVICT_TIMEOUT=1000
DATABASE_MAX_QUERY_TIME=30000

# Database Behavior Settings
DATABASE_SYNCHRONIZE=true
DATABASE_MIGRATIONS_RUN=false
DATABASE_RETRY_ATTEMPTS=3
DATABASE_RETRY_DELAY=3000
DATABASE_TIMEZONE=UTC

# Production SSL Settings (only for production)
# DATABASE_CA_CERT=path/to/ca-certificate.crt
# DATABASE_CLIENT_KEY=path/to/client-key.key
# DATABASE_CLIENT_CERT=path/to/client-certificate.crt

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# IMPORTANT: Use strong, unique secrets in production (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# TWILIO WHATSAPP CONFIGURATION
# ===========================================
# Get from Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
TWILIO_WEBHOOK_URL=https://your-domain.com/api/v1/whatsapp/webhook
TWILIO_STATUS_CALLBACK=https://your-domain.com/api/v1/whatsapp/status

# ===========================================
# OPENAI CONFIGURATION
# ===========================================
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OPENAI_ORGANIZATION=org-xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# COHERE CONFIGURATION (Optional - Multilingual Support)
# ===========================================
# Get API key from: https://dashboard.cohere.ai/
COHERE_API_KEY=your_cohere_api_key_here
COHERE_MODEL=command-xlm-beta

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10
WHATSAPP_THROTTLE_LIMIT=5

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM=noreply@settlesmart.ai

# ===========================================
# SMS CONFIGURATION (Optional - Backup Communication)
# ===========================================
SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key_here
SMS_FROM=SettleSmart

# ===========================================
# REDIS CONFIGURATION (Optional - Recommended for Production)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_KEY_PREFIX=settlesmart:
REDIS_CACHE_DB=1

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# ===========================================
# BUSINESS LOGIC CONFIGURATION
# ===========================================
DEFAULT_LOCATION=Lugbe, Abuja
MAX_PROPERTIES_PER_AGENT=50
FREE_AGENT_LISTING_LIMIT=5
PREMIUM_AGENT_LISTING_LIMIT=100
SEARCH_RADIUS=10
CONVERSATION_TIMEOUT_MINUTES=30

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_VOICE_MESSAGES=false
ENABLE_MULTI_LANGUAGE=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_ANALYTICS=true
ENABLE_IMAGE_RECOGNITION=false

# ===========================================
# HEALTH CHECK CONFIGURATION
# ===========================================
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=60000

# ===========================================
# API DOCUMENTATION (Swagger)
# ===========================================
SWAGGER_ENABLED=true
SWAGGER_TITLE=SettleSmart AI API
SWAGGER_DESCRIPTION=Intelligent Property Matching API for Nigeria
SWAGGER_VERSION=1.0.0

# ===========================================
# WEBHOOK SECURITY
# ===========================================
WEBHOOK_SECRET=your-webhook-secret-minimum-16-characters

# ===========================================
# ADMIN CONFIGURATION (Optional)
# ===========================================
ADMIN_EMAIL=admin@settlesmart.ai
ADMIN_PASSWORD=secure_admin_password_here

# ===========================================
# QUICK SETUP FOR DEVELOPMENT
# ===========================================
# 1. Copy this file: cp .env.example .env
# 2. Update DATABASE_PASSWORD with your PostgreSQL password
# 3. Create database: createdb settlesmart_db
# 4. Add your Twilio credentials (for WhatsApp testing)
# 5. Add your OpenAI API key (for AI features)
# 6. Run: npm run start:dev